---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const categories = [
  { name: 'Home & Kitchen', slug: 'home-kitchen', count: 45, emoji: '🏠', color: 'from-amber-50 to-orange-50' },
  { name: 'Fitness & Health', slug: 'fitness-health', count: 38, emoji: '💪', color: 'from-green-50 to-emerald-50' },
  { name: 'Beauty & Personal Care', slug: 'beauty-care', count: 42, emoji: '✨', color: 'from-pink-50 to-rose-50' },
  { name: 'Smart Home', slug: 'smart-home', count: 31, emoji: '🤖', color: 'from-blue-50 to-indigo-50' },
  { name: 'Outdoor & Travel', slug: 'outdoor-travel', count: 28, emoji: '🏕️', color: 'from-stone-50 to-slate-50' }
];
---
<BaseLayout title="CategoriesBrowse - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h1 class="font-playfair text-5xl md:text-6xl font-bold text-dark-bg mb-4">Browse by Category</h1>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-primary to-transparent mx-auto mb-6"></div>
        <p class="font-inter text-lg text-secondary max-w-2xl mx-auto">Explore curated quality products across five categories</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {categories.map((cat, i) => (
          <a href={`/blog?category=${cat.slug}`} class="card-hover rounded-2xl overflow-hidden bg-gradient-to-br {cat.color} border border-border p-8 text-center group" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="w-20 h-20 rounded-full bg-white/80 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <span class="text-4xl">{cat.emoji}</span>
            </div>
            <h3 class="font-playfair font-semibold text-xl text-dark-bg mb-3">{cat.name}</h3>
            <span class="inline-block font-inter text-sm text-muted bg-white/60 px-4 py-1.5 rounded-full">{cat.count} Product Reviews</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
