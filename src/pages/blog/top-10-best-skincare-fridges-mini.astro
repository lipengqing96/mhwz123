---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: 'Top 10 Best Mini Skincare Fridges in 2026',
  reviewBody: 'Comprehensive guide to the best mini skincare fridges for keeping your beauty products fresh and effective.',
  author: { '@type': 'Organization', name: 'LuxeRank Editorial Team' },
  datePublished: 'undefined',
  dateModified: 'undefined',
  reviewRating: { '@type': 'Rating', ratingValue: '4.7', bestRating: '5' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.7', reviewCount: '2,340' }
};
---
<BaseLayout title="Top 10 Best Mini Skincare Fridges in 2026 - LuxeRank" description="Comprehensive guide to the best mini skincare fridges for keeping your beauty products fresh and effective.">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <script type="application/ld+json">{JSON.stringify(schema)}</script>
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-8" data-aos="fade-up">
        <span class="inline-block font-inter text-xs bg-gold-primary text-dark-bg px-4 py-1 rounded-full font-semibold mb-4">Beauty & Personal Care</span>
        <h1 class="font-playfair text-4xl md:text-5xl font-bold text-dark-bg leading-tight mb-4">Top 10 Best Mini Skincare Fridges in 2026</h1>
        <div class="flex items-center gap-4 font-inter text-sm text-muted">
          <span>2026-08-05</span><span>&bull;</span><span>7 min read</span><span>&bull;</span>
