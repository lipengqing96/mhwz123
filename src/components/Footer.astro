        <li><a href="/categories" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Categories</a></li>
        <li><a href="/contact" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-playfair font-semibold text-lg text-gold-light mb-4">Legal</h4>
      <ul class="space-y-2">
        <li><a href="/privacy" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Terms of Service</a></li>
        <li><a href="/affiliate-disclosure" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Affiliate Disclosure</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-6 pt-8 mt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
