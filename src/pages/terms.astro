---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Terms of Service - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6" data-aos="fade-up">
      <h1 class="font-playfair text-4xl md:text-5xl font-bold text-dark-bg mb-8">Terms of Service</h1>
      <p class="font-inter text-sm text-muted mb-12">Last updated：1 1, 2026</p>
      <div class="prose prose-lg max-w-none">
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Acceptance of Terms</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">Accessing and using LuxeRank website means you agree to be bound byTerms of Service。if you do not agree with any part of these terms，please do not use this website。</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Content Usage</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">All content on this website (including but not limited to text, images, designs, and icons) is protected by copyright. You may not reproduce, modify, distribute, or create derivative works without written permission.</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Affiliate Disclosure</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">This website contains affiliate marketing links。When youourwhen purchasing through links，we may earn a commission。This will not affect your purchase price，but helps support our continued free product review content。</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Disclaimer</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">We strive to ensure the accuracy and timeliness of website content, but do not guarantee the completeness or accuracy of all information. Any decisions made based on website content are at your own risk.</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Limitation of Liability</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">To the fullest extent permitted by law, LuxeRank is not liable for any indirect, incidental, special, or consequential damages.</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Changes to Terms</h2>
        <p class="font-inter text-secondary leading-relaxed">We reserve the right to modify these terms at any time. Material changes will be notified to users through website announcements.</p>
      </div>
    </div>
  </section>
</BaseLayout>
