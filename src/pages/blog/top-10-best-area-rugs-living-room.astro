<tr class="hover:bg-cream transition-colors"><td class="px-4 py-4"><span class="font-bold text-gold-primary">#1</span></td><td class="px-4 py-4 font-semibold">nuLOOM Moroccan Bled</td><td class="px-4 py-4">$79.99</td><td class="px-4 py-4">Hand-loomed, reversible</td><td class="px-4 py-4"><span class="text-gold-primary">★★★★★</span></td><td class="px-4 py-4 text-secondary">Moroccan design</td></tr>
