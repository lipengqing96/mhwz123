---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Ninja Foodi、COSORI、飞利浦空气炸锅等热门选... - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="py-24 bg-white min-h-screen flex items-center justify-center">
    <div class="text-center px-6">
      <div class="text-8xl mb-6">🍳</div>
      <h1 class="font-playfair text-4xl md:text-5xl font-bold text-dark-bg mb-4">文章开发中</h1>
      <p class="font-inter text-secondary text-lg mb-8">Ninja Foodi、COSORI、飞利浦空气炸锅等热门选择，健康烹饪新选择。价格区间50-200美元。</p>
      <a href="/blog" class="btn-gold-outline">返回博客列表</a>
    </div>
  </section>
</BaseLayout>
