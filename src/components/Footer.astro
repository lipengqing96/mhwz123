  <div class="max-w-7xl mx-auto px-6 pt-12 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <div class="flex flex-col items-start mb-4">
        <span class="font-playfair font-bold text-3xl gold-gradient-text tracking-tight">LuxeRank</span>
        <span class="font-inter text-xs text-muted tracking-widest uppercase mt-[-4px]">Living</span>
      </div>
      <p class="font-inter text-sm text-muted leading-relaxed">Curated reviews and expert insights for discerning lifestyles.</p>
    </div>
    <div>
      <h4 class="font-playfair font-semibold text-lg text-gold-light mb-4">About Us</h4>
      <ul class="space-y-2">
        <li><a href="/about" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Our Team</a></li>
        <li><a href="/about" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Editorial Process</a></li>
        <li><a href="/about" class="font-inter text-sm text-muted hover:text-gold-primary transition-colors">Our Mission</a></li>
