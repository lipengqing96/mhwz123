cdd2085?w=800&q=80"}, {"title": "最佳客厅地毯推荐Top10", "slug": "top-10-best-area-rugs-living-room", "cat": "家居与厨房", "slugCat": "home-kitchen", "time": "6分钟", "date": "2026-05-20", "desc": "nuLOOM、Mohawk、Rugs USA、Well Woven等品牌深度测评。", "img": "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=800&q=80"}];
---
<BaseLayout title="博客 - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h1 id="blog-category-title" class="font-playfair text-5xl md:text-6xl font-bold text-dark-bg mb-4">产品评测博客</h1>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-primary to-transparent mx-auto mb-6"></div>
        <p class="font-inter text-lg text-secondary max-w-2xl mx-auto">专家深度评测，真实用户体验，帮助您做出明智的购买决策。</p>
        <a id="back-to-all" href="/blog" class="inline-block mt-6 font-inter text-sm text-gold-primary hover:underline hidden">← 查看全部文章</a>
      </div>
      <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, i) => (
          <a href={'/blog/' + post.slug} class="card-hover bg-white rounded-2xl overflow-hidden shadow-card group post-card" data-cat={post.slugCat} data-aos="fade-up" data-aos-delay={i * 50}>
            <div class="h-48 relative overflow-hidden">
              <img src={post.img} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/60 via-transparent to-transparent"></div>
              <span class="absolute top-4 left-4 font-inter text-xs bg-gold-primary text-dark-bg px-3 py-1 rounded-full font-semibold">{post.cat}</span>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-inter text-xs text-muted">{post.date}</span>
                <span class="font-inter text-xs text-muted">•</span>
                <span class="font-inter text-xs text-muted">{post.time}阅读</span>
              </div>
              <h3 class="font-playfair font-semibold text-lg text-dark-bg mb-3 line-clamp-2 group-hover:text-gold-primary transition-colors">{post.title}</h3>
              <p class="font-inter text-sm text-secondary leading-relaxed line-clamp-2">{post.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <script is:inline>
    const categoryMap={'home-kitchen':'家居与厨房','fitness-health':'健身与健康','beauty-care':'美容与个人护理','smart-home':'智能家居','outdoor-travel':'户外与旅行'};
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    const titleEl = document.getElementById('blog-category-title');
    const backEl = document.getElementById('back-to-all');
    const cards = document.querySelectorAll('.post-card');
    if (cat && categoryMap[cat]) { titleEl.textContent = categoryMap[cat] + ' 评测文章'; backEl.classList.remove('hidden'); cards.forEach(card => { card.style.display = card.dataset.cat === cat ? '' : 'none'; }); }
  </script>
</BaseLayout>
