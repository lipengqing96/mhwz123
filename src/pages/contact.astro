---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="联系我们 - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <section class="py-24 bg-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h1 class="font-playfair text-5xl md:text-6xl font-bold text-dark-bg mb-6">联系我们</h1>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-primary to-transparent mx-auto mb-6"></div>
        <p class="font-inter text-lg text-secondary">有任何问题或建议？我们期待与您的交流。</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div data-aos="fade-right">
          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h2 class="font-playfair text-2xl font-bold text-dark-bg mb-6">发送消息</h2>
            <form class="space-y-6">
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">姓名</label>
                <input type="text" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors" placeholder="请输入您的姓名" />
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">邮箱</label>
                <input type="email" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors" placeholder="请输入您的邮箱" />
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">主题</label>
                <select class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors bg-white">
                  <option>合作咨询</option>
                  <option>内容反馈</option>
                  <option>技术支持</option>
                  <option>其他</option>
                </select>
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">留言内容</label>
                <textarea rows="5" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors resize-none" placeholder="请输入您的留言内容..."></textarea>
              </div>
              <button type="submit" class="w-full btn-gold">提交消息</button>
            </form>
          </div>
        </div>

        <div data-aos="fade-left" class="space-y-8">
          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">联系方式</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gold-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <p class="font-inter text-sm text-muted mb-1">邮箱</p>
                  <p class="font-inter text-sm text-dark-bg font-semibold">contact@luxerrank.com</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gold-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="font-inter text-sm text-muted mb-1">地址</p>
                  <p class="font-inter text-sm text-dark-bg font-semibold">美国加利福尼亚州洛杉矶</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">工作时间</h3>
            <div class="space-y-2 font-inter text-sm">
              <div class="flex justify-between"><span class="text-secondary">周一至周五</span><span class="text-dark-bg font-semibold">9:00 AM - 6:00 PM (PST)</span></div>
              <div class="flex justify-between"><span class="text-secondary">周末</span><span class="text-dark-bg font-semibold">休息</span></div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">合作伙伴</h3>
            <p class="font-inter text-secondary leading-relaxed mb-4">如果您是我们的潜在合作伙伴，欢迎通过以下方式联系我们：</p>
            <p class="font-inter text-sm font-semibold text-dark-bg">business@luxerrank.com</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
