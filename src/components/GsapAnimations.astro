---
const gsapConfig = {
  sectionReveal: {
    query: '[data-gsap-reveal]',
    props: { y: 40, opacity: 0, duration: 0.8, ease: 'power2.out' }
  },
  staggerCards: { containerClass: '.gsap-stagger', cardClass: '.gsap-card' },
  parallaxBg: { selector: '[data-parallax-bg]' },
  floatingCards: { selector: '[data-float]' },
  goldLine: { selector: '[data-gold-line]' },
  counter: { selector: '[data-counter]' }
};
---
<script client:load>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Section reveal
  gsap.utils.toArray(gsapConfig.sectionReveal.query).forEach(el => {
    gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }, ...gsapConfig.sectionReveal.props });
  });

  // Staggered cards
  gsap.utils.toArray(gsapConfig.staggerCards.containerClass).forEach(container => {
    const cards = container.querySelectorAll(gsapConfig.staggerCards.cardClass);
    gsap.from(cards, { scrollTrigger: { trigger: container, start: 'top 80%', toggleActions: 'play none none reverse' }, y: 50, opacity: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out' });
  });

  // Parallax hero bg
  const heroBg = document.querySelector(gsapConfig.parallaxBg.selector);
  if (heroBg) {
    gsap.to(heroBg, { scrollTrigger: { trigger: heroBg.closest('section'), start: 'top bottom', end: 'bottom top', scrub: true }, y: -80, ease: 'none' });
  }

  // Floating cards
  gsap.utils.toArray(gsapConfig.floatingCards.selector).forEach((el, i) => {
    gsap.to(el, { y: i % 2 === 0 ? -12 : 12, duration: 2 + i * 0.3, repeat: -1, yoyo: true, ease: 'sine.inOut' });
  });

  // Gold line draw
  gsap.utils.toArray(gsapConfig.goldLine.selector).forEach(el => {
    gsap.from(el, { scrollTrigger: { trigger: el, start: 'top 90%', toggleActions: 'play none none reverse' }, scaleX: 0, duration: 0.8, ease: 'power2.out', transformOrigin: 'left center' });
  });

  // Counter
  gsap.utils.toArray(gsapConfig.counter.selector).forEach(el => {
    const target = parseInt(el.dataset.counter);
    if (isNaN(target)) return;
    const obj = { val: 0 };
    gsap.to(obj, { scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }, val: target, duration: 2, ease: 'power1.out', onUpdate: () => { el.textContent = Math.floor(obj.val).toLocaleString() + (el.dataset.suffix || ''); } });
  });
</script>