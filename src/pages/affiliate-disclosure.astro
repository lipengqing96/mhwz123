---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Affiliate Disclosure - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="py-24 bg-cream">
    <div class="max-w-3xl mx-auto px-6" data-aos="fade-up">
      <h1 class="font-playfair text-4xl md:text-5xl font-bold text-dark-bg mb-8">Affiliate Disclosurestatement</h1>
      <div class="bg-white rounded-2xl p-8 shadow-card mb-8">
        <p class="font-inter text-secondary leading-relaxed mb-4"><strong class="text-dark-bg">Important Statement:</strong>As an Amazon Associate, we earn from qualifying purchases.</p>
        <p class="font-inter text-secondary leading-relaxed">This means when you purchase products through links on this website, we may earn a small commission. This does not increase your purchase cost but helps support our continued production of high-quality product review content.</p>
      </div>
      <div class="prose prose-lg max-w-none">
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Our Stance</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">All recommendations are independent and unbiased. Our review team independently purchases all test products and does not accept free products or compensation from brands to influence review results. Our ratings and recommendations are based solely on actual product performance and user value.</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4"> FTC Compliance Statement</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">In compliance with the Federal Trade Commission (FTC) requirement, we disclose that this website contains affiliate marketing links. Purchases made through these links may earn us a commission.</p>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">Other Affiliate Programs</h2>
        <p class="font-inter text-secondary leading-relaxed mb-6">In addition to the Amazon Associates program, we may participate in other affiliate marketing programs, including but not limited to:</p>
        <ul class="list-disc list-inside font-inter text-secondary leading-relaxed mb-6 space-y-2">
          <li>Best Buy Affiliate Program</li>
          <li>Walmart Affiliate Program</li>
          <li>Target Affiliate Program</li>
          <li>Direct affiliate programs from specific brands</li>
        </ul>
        <h2 class="font-playfair text-2xl font-bold text-dark-bg mt-8 mb-4">How to Identify Affiliate Links</h2>
        <p class="font-inter text-secondary leading-relaxed">Our affiliate links typically display text like "Check Price on Amazon" in buttons or text links. When you are redirected to a third-party website to complete a purchase, it is an affiliate link.</p>
      </div>
    </div>
  </section>
</BaseLayout>
