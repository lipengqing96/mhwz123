---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="About Us - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h1 class="font-playfair text-5xl md:text-6xl font-bold text-dark-bg mb-6">About Us</h1>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-primary to-transparent mx-auto mb-6"></div>
        <p class="font-inter text-lg text-secondary max-w-2xl mx-auto leading-relaxed">LuxeRank Founded in 2026，dedicated to providing the most professional、and objective product reviews。We believe，every carefully selected product，can add quality and style to your life。</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20" data-aos="fade-up">
        <div class="bg-cream rounded-2xl p-8">
          <h2 class="font-playfair text-2xl font-bold text-dark-bg mb-4">Our Mission</h2>
          <p class="font-inter text-secondary leading-relaxed">In an era of information overload，consumers face unprecedented choice paralysis。Our review team consists of experienced industry experts，through rigorous testing，providing genuinely valuable purchasing advice。We commit that every review is based on real user experiences，free from brand influence。</p>
        </div>
        <div class="bg-cream rounded-2xl p-8">
          <h2 class="font-playfair text-2xl font-bold text-dark-bg mb-4">Editorial Process</h2>
          <p class="font-inter text-secondary leading-relaxed">Our review process includes: Product Research (3 days)→ Field Testing (7 days)→ Comparative Analysis (2 days)→ Content Writing (3 days)→ Expert Review (1 day)。Each review undergoes at least 3 rounds of editing，ensuring accuracy and objectivity。All test products are purchased through legitimate channels，we never accept free products from brands。</p>
        </div>
      </div>

      <div class="text-center" data-aos="fade-up">
        <div class="inline-grid grid-cols-3 gap-8 mb-12">
          <div class="text-center">
            <div class="font-playfair text-4xl font-bold gold-gradient-text mb-2">500+</div>
            <div class="font-inter text-sm text-muted">Products Tested</div>
          </div>
          <div class="text-center">
            <div class="font-playfair text-4xl font-bold gold-gradient-text mb-2">50,000+</div>
            <div class="font-inter text-sm text-muted">Subscribers</div>
          </div>
          <div class="text-center">
            <div class="font-playfair text-4xl font-bold gold-gradient-text mb-2">100%</div>
            <div class="font-inter text-sm text-muted">Independent Reviews</div>
          </div>
        </div>
        <p class="font-inter text-secondary max-w-2xl mx-auto leading-relaxed">We are a passionate team，every member is a product enthusiast。From kitchen appliances to smart wearables，from fitness equipment to beauty tools，we use professional perspectives to curate every product worth buying。</p>
      </div>
    </div>
  </section>
</BaseLayout>
