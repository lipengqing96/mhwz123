---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contact - LuxeRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <section class="py-24 bg-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h1 class="font-playfair text-5xl md:text-6xl font-bold text-dark-bg mb-6">Contact</h1>
        <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-primary to-transparent mx-auto mb-6"></div>
        <p class="font-inter text-lg text-secondary">Have questions or suggestions? We would love to hear from you.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div data-aos="fade-right">
          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h2 class="font-playfair text-2xl font-bold text-dark-bg mb-6">Send Message</h2>
            <form class="space-y-6">
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">Name</label>
                <input type="text" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors" placeholder="Enter your name" />
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">Email</label>
                <input type="email" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors" placeholder="Enter your email address" />
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">Subject</label>
                <select class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors bg-white">
                  <option>Partnership Inquiry</option>
                  <option>Content Feedback</option>
                  <option>Tech Support</option>
                  <option>Other</option>
                </select>
              </div>
              <div>
                <label class="block font-inter text-sm font-medium text-dark-bg mb-2">Message</label>
                <textarea rows="5" class="w-full px-4 py-3 rounded-lg border border-border font-inter focus:outline-none focus:border-gold-primary transition-colors resize-none" placeholder="Type your message..."></textarea>
              </div>
              <button type="submit" class="w-full btn-gold">Send Message</button>
            </form>
          </div>
        </div>

        <div data-aos="fade-left" class="space-y-8">
          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">Contact Info</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gold-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <p class="font-inter text-sm text-muted mb-1">Email</p>
                  <p class="font-inter text-sm text-dark-bg font-semibold">contact@luxerrank.com</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gold-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="font-inter text-sm text-muted mb-1">Address</p>
                  <p class="font-inter text-sm text-dark-bg font-semibold">Los Angeles, California, USA</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">Business Hours</h3>
            <div class="space-y-2 font-inter text-sm">
              <div class="flex justify-between"><span class="text-secondary">Monday - Friday</span><span class="text-dark-bg font-semibold">9:00 AM - 6:00 PM (PST)</span></div>
              <div class="flex justify-between"><span class="text-secondary">Weekends</span><span class="text-dark-bg font-semibold">Closed</span></div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h3 class="font-playfair text-xl font-bold text-dark-bg mb-4">Partnerships</h3>
            <p class="font-inter text-secondary leading-relaxed mb-4">If youis ourpotentialPartnerships,feel free to reach out throughContact:</p>
            <p class="font-inter text-sm font-semibold text-dark-bg">business@luxerrank.com</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
